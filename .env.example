APP_ENV=development
DATABASE_URL=postgresql+psycopg2://widget:widget@db:5432/widgetforge
JWT_SECRET=replace-this-before-any-non-demo-use
JWT_EXPIRE_MINUTES=60
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_WIDGET_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_SUBMISSION_BYTES=16384
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
IP_HASH_SECRET=replace-this-too
NOTIFIER_MODE=console
GEO_ENRICHMENT_ENABLED=false
GEO_REQUEST_TIMEOUT_SECONDS=1.5
OUTBOX_POLL_SECONDS=2
